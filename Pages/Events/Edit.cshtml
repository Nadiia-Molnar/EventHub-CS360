@page
@model EventHub.Pages.Events.EditModel

@{
    ViewData["Title"] = "Edit Event";
}

<h1>Edit Event</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="EventCalendar.event_id" />

            <div class="form-group">
                <label asp-for="EventCalendar.venue_id" class="control-label"></label>
                <select asp-for="EventCalendar.venue_id" asp-items="Model.VenueOptions" class="form-select">
                    <option value="">-- Select a venue --</option>
                </select>
                <span asp-validation-for="EventCalendar.venue_id" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="EventCalendar.organizer_id" class="control-label"></label>
                <input asp-for="EventCalendar.organizer_id" class="form-control" />
                <span asp-validation-for="EventCalendar.organizer_id" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="EventCalendar.name" class="control-label"></label>
                <input asp-for="EventCalendar.name" class="form-control" />
                <span asp-validation-for="EventCalendar.name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="EventCalendar.description" class="control-label"></label>
                <input asp-for="EventCalendar.description" class="form-control" />
                <span asp-validation-for="EventCalendar.description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="EventCalendar.date" class="control-label"></label>
                <input asp-for="EventCalendar.date" class="form-control" />
                <span asp-validation-for="EventCalendar.date" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="EventCalendar.time" class="control-label"></label>
                <input asp-for="EventCalendar.time" class="form-control" />
                <span asp-validation-for="EventCalendar.time" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="EventCalendar.category" class="control-label"></label>
                <input asp-for="EventCalendar.category" class="form-control" />
                <span asp-validation-for="EventCalendar.category" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}