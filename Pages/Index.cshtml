@page
@model IndexModel

@{
    ViewData["Title"] = "EventHub";
}

<div class="text-center py-4">
    <h1 class="display-4">Welcome to EventHub</h1>
    <p class="lead">
        Manage event venues, event details, team roles, and MongoDB event groups.
    </p>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <h2>Venues</h2>
        <p>View and manage event locations, addresses, cities, and capacities.</p>
        <a class="btn btn-primary" asp-page="/CS360/Index">Open Venues</a>
    </div>

    <div class="col-md-6">
        <h2>Events</h2>
        <p>Manage scheduled events and select their venue from the drop-down list.</p>
        <a class="btn btn-primary" asp-page="/Events/Index">Open Events</a>
    </div>

    <div class="col-md-6">
        <h2>Roles</h2>
        <p>View and manage the roles used by EventHub.</p>
        <a class="btn btn-primary" asp-page="/Roles/Index">Open Roles</a>
    </div>

    <div class="col-md-6">
        <h2>Event Groups</h2>
        <p>Explore live MongoDB Atlas data and sort groups by name or capacity.</p>
        <a class="btn btn-primary" asp-page="/Groups/Index">Open Event Groups</a>
    </div>
</div>