@page
@model EventHub.Pages.Events.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.EventCalendar[0].venue_id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EventCalendar[0].organizer_id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EventCalendar[0].name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EventCalendar[0].description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EventCalendar[0].date)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EventCalendar[0].time)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EventCalendar[0].category)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EventCalendar[0].created_at)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EventCalendar[0].updated_at)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.EventCalendar)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.venue_id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.organizer_id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.description)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.date)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.time)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.category)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.created_at)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.updated_at)
                </td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.event_id">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.event_id">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.event_id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
